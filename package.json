{
  "name": "aether",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @aether/server --filter @aether/web dev",
    "build": "pnpm --filter @aether/shared build && pnpm --filter @aether/server build && pnpm --filter @aether/web build",
    "db:migrate": "pnpm --filter @aether/server db:migrate",
    "db:push": "pnpm --filter @aether/server db:push",
    "db:seed": "pnpm --filter @aether/server db:seed",
    "eval": "pnpm --filter @aether/server eval"
  }
}
